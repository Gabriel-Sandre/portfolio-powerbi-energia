table dMunicipios
	lineageTag: 6a7a6fa2-2149-524c-a710-ae4e34dd0652

	column Cod_Municipio
		dataType: string
		isHidden
		lineageTag: 46a3fca0-7235-535c-8a14-66a17daa602d
		summarizeBy: none
		sourceColumn: Cod_Municipio

		annotation SummarizationSetBy = Automatic

	column Municipio
		dataType: string
		lineageTag: daf7894b-11dc-5fae-86b0-64571d5bbf17
		summarizeBy: none
		sourceColumn: Municipio

		annotation SummarizationSetBy = Automatic

	column Regional
		dataType: string
		isHidden
		lineageTag: a5169294-0509-5482-afab-99715c5a7b26
		summarizeBy: none
		sourceColumn: Regional

		annotation SummarizationSetBy = Automatic

	column UF
		dataType: string
		lineageTag: dba0e036-ef50-5677-a70b-16cd7f83247f
		summarizeBy: none
		sourceColumn: UF

