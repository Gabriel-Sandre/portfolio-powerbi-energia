{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "dispersao",
  "position": {
    "x": 220,
    "y": 422,
    "z": 1500,
    "height": 278,
    "width": 620
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dConjuntos"
                    }
                  },
                  "Property": "Conjunto"
                }
              },
              "queryRef": "dConjuntos.Conjunto"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fInterrupcoes"
                    }
                  },
                  "Property": "% do Limite FEC"
                }
              },
              "queryRef": "fInterrupcoes.% do Limite FEC"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fInterrupcoes"
                    }
                  },
                  "Property": "% do Limite DEC"
                }
              },
              "queryRef": "fInterrupcoes.% do Limite DEC"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fInterrupcoes"
                    }
                  },
                  "Property": "Clientes Atendidos"
                }
              },
              "queryRef": "fInterrupcoes.Clientes Atendidos"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'% do limite: FEC (horizontal) x DEC (vertical). Acima de 100% = fora do limite'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}