                  "Property": "Mês/Ano"
                }
              },
              "queryRef": "dCalendario.Mês/Ano"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fInterrupcoes"
                    }
                  },
                  "Property": "DEC (h)"
                }
              },
              "queryRef": "fInterrupcoes.DEC (h)"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fInterrupcoes"
                    }
                  },
                  "Property": "DEC Ano Anterior (h)"
                }
              },
              "queryRef": "fInterrupcoes.DEC Ano Anterior (h)"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'DEC mensal (h) x mesmo mês do ano anterior: picos no verão'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
