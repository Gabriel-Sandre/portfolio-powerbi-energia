model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["PastaDados", "dConjuntos", "dCausas", "fBaseClientes", "fInterrupcoes"]

	annotation __PBI_TimeIntelligenceEnabled = 0

ref table dConjuntos
ref table dCausas
ref table fBaseClientes
ref table fInterrupcoes
ref table dCalendario
ref table 'Top N'
