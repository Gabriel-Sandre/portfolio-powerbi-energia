		sourceColumn: [Mês/Ano]
		sortByColumn: AnoMes

		annotation SummarizationSetBy = Automatic

	column Trimestre
		dataType: string
		lineageTag: 906726f0-e4ec-5671-9565-b3c789cc5c86
		summarizeBy: none
