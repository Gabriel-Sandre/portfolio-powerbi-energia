		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	column 'Período Climático'
		dataType: string
		lineageTag: 9d37a29d-347d-5294-ae03-5f88ba485389
		summarizeBy: none
		isNameInferred
		sourceColumn: [Período Climático]

		annotation SummarizationSetBy = Automatic

	column 'Tem Dados'
		dataType: boolean
		lineageTag: e14fa582-1621-56d8-8a6c-12763b838947
		summarizeBy: none
		isNameInferred
		sourceColumn: [Tem Dados]

		annotation SummarizationSetBy = Automatic

	partition dCalendario = calculated
		mode: import
		source =
				VAR DataMin = DATE ( YEAR ( MIN ( fInterrupcoes[Data] ) ), 1, 1 )
				VAR DataMax = DATE ( YEAR ( MAX ( fInterrupcoes[Data] ) ), 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( DataMin, DataMax ),
				        "Ano", YEAR ( [Date] ),
				        "Mês Nº", MONTH ( [Date] ),
				        "Mês", SWITCH ( MONTH ( [Date] ), 1, "Jan", 2, "Fev", 3, "Mar", 4, "Abr", 5, "Mai", 6, "Jun",
				                        7, "Jul", 8, "Ago", 9, "Set", 10, "Out", 11, "Nov", 12, "Dez" ),
				        "AnoMes", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Mês/Ano", SWITCH ( MONTH ( [Date] ), 1, "Jan", 2, "Fev", 3, "Mar", 4, "Abr", 5, "Mai", 6, "Jun",
				                            7, "Jul", 8, "Ago", 9, "Set", 10, "Out", 11, "Nov", 12, "Dez" )
				                     & "/" & RIGHT ( YEAR ( [Date] ), 2 ),
				        "Trimestre", "T" & QUARTER ( [Date] ),
				        "Período Climático", IF ( MONTH ( [Date] ) IN { 12, 1, 2, 3 }, "Verão (chuvas)", "Demais meses" ),
				        "Tem Dados", [Date] <= MAX ( fInterrupcoes[Data] )
				    )

	annotation PBI_ResultType = Table
