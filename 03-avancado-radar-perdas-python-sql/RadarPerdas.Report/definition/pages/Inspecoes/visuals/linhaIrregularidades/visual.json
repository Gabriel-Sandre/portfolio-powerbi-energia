{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "linhaIrregularidades",
  "position": {
    "x": 220,
    "y": 504,
    "z": 1900,
    "height": 196,
    "width": 1040
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dCalendario"
                    }
                  },
                  "Property": "Mês/Ano"
                }
              },
              "queryRef": "dCalendario.Mês/Ano",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fBalanco"
                    }
                  },
                  "Property": "Irregularidades"
                }
              },
              "queryRef": "fBalanco.Irregularidades"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Irregularidades encontradas por mês'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}