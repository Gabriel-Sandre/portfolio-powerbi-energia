table Rejeicoes
	lineageTag: 82f9483c-6bba-5157-a9bf-eb01fc48530f

	column Execucao_ID
		dataType: int64
		isHidden
		lineageTag: c7869e64-4895-5d8f-8b96-a1ff170e20eb
		summarizeBy: none
		sourceColumn: Execucao_ID

		annotation SummarizationSetBy = Automatic

	column Arquivo
		dataType: string
		lineageTag: dc1afa64-a376-54d2-8c49-604d0328628e
		summarizeBy: none
		sourceColumn: Arquivo

		annotation SummarizationSetBy = Automatic

	column Motivo
		dataType: string
		lineageTag: 33044e43-61ec-5910-b961-0ab947d49d87
		summarizeBy: none
		sourceColumn: Motivo

		annotation SummarizationSetBy = Automatic

	column Linhas
		dataType: int64
		formatString: #,0
		lineageTag: c074c7a2-7f5d-52fb-96d1-62e3b8461989
		summarizeBy: none
		sourceColumn: Linhas

		annotation SummarizationSetBy = Automatic

	partition Rejeicoes = m
		mode: import
		source =
				// Agrupar no Power Query "dobra" para o SQL Server (vira um GROUP BY lá): só o resumo é importado.
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Dados = Fonte{[Schema = "dw", Item = "Rejeicao"]}[Data],
				    Agrupado = Table.Group(Dados, {"Execucao_ID", "Arquivo", "Motivo"}, {{"Linhas", each Table.RowCount(_), Int64.Type}}),
				    Tipos = Table.TransformColumnTypes(Agrupado, {{"Execucao_ID", Int64.Type}, {"Arquivo", type text}, {"Motivo", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table

