// =====================================================================
// Projeto 3 - Tabelas calculadas (Modelagem > Nova tabela)
// =====================================================================

// ---------- Tabela calculada (Modelagem > Nova tabela) ----------
// Marcar como tabela de datas (coluna Date). Classificar "Mês/Ano" por "AnoMes".
dCalendario =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2025, 1, 1 ), DATE ( 2026, 12, 31 ) ),
    "Ano", YEAR ( [Date] ),
    "AnoMes", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
    "Mês/Ano", SWITCH ( MONTH ( [Date] ), 1, "Jan", 2, "Fev", 3, "Mar", 4, "Abr", 5, "Mai", 6, "Jun",
                        7, "Jul", 8, "Ago", 9, "Set", 10, "Out", 11, "Nov", 12, "Dez" )
                 & "/" & RIGHT ( YEAR ( [Date] ), 2 )
)

// ---------- Parâmetro de tarifa ----------
// Permite simular "quanto vale" a energia perdida com outra tarifa (R$/kWh).
// Pela interface: Modelagem > Novos parâmetros > Intervalo numérico (0,50 a 1,50, passo 0,05).
'Tarifa Referencia' =
SELECTCOLUMNS ( GENERATESERIES ( 0.50, 1.50, 0.05 ), "Tarifa Referencia", ROUND ( [Value], 2 ) )
